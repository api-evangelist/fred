{
  "opencollection": "1.0.0",
  "info": {
    "name": "FRED Maps API (GeoFRED) Categories Series Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Series Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "FRED Get Regional Data Values for a Series",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stlouisfed.org/geofred/series/data",
            "params": [
              {
                "name": "api_key",
                "value": "abcdef0123456789abcdef0123456789",
                "type": "query",
                "description": "32-character lower-case alphanumeric FRED API key."
              },
              {
                "name": "file_type",
                "value": "json",
                "type": "query",
                "description": "Response format — json or xml."
              },
              {
                "name": "series_id",
                "value": "UNRATE",
                "type": "query",
                "description": "The FRED series ID."
              },
              {
                "name": "date",
                "value": "2026-04-01",
                "type": "query",
                "description": "Date for the data values (YYYY-MM-DD). Defaults to the most recent."
              },
              {
                "name": "start_date",
                "value": "2026-01-01",
                "type": "query",
                "description": "Optional start date for a range query."
              }
            ]
          },
          "docs": "Get regional data values attached to a specific FRED series."
        }
      ]
    }
  ],
  "bundled": true
}