    },
    "offset": {
      "@id": "fred:offset",
      "@type": "xsd:integer"
    },
    "limit": {
      "@id": "fred:limit",
      "@type": "xsd:integer"
    },
    "observations": {
      "@id": "fred:observations",
      "@container": "@set",
      "@type": "xsd:string"
    },
    "date": {
      "@id": "fred:date",
      "@type": "xsd:date"
    },
    "value": {
      "@id": "fred:value",
      "@type": "xsd:string"
    },
    "releaseDates": {
